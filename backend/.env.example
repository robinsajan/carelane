# Server-only. Copy to .env and insert the Neon connection URL.
# Never prefix DATABASE_URL with NEXT_PUBLIC_.
# True: read and write local SQLite, even with a Neon URL configured.
# False: read and write Neon (requires DATABASE_URL). Restart after changing.
local_db=False
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require&channel_binding=require
# Optional SQLite file used when local_db=True:
# OPD_DATABASE=C:/path/to/hospital/backend/data/opd.sqlite3
# Optional: PostgreSQL schema (default public).
# OPD_DATABASE_SCHEMA=public
